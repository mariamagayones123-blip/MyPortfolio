# Secrets required by Edge Functions, set via `supabase secrets set` (remote) or a local
# `supabase/functions/.env` (gitignored, never committed) for `supabase functions serve`.
# See docs/06_Supabase/Environment.md and docs/06_Supabase/API_Keys.md.
#
# NOTE: the functions that use these (submit-message, log-analytics-event) are architected in
# Phase 3 (see docs/05_Database/Migration_Strategy.md and the messages/analytics_events RLS design
# in docs/05_Database/Row_Level_Security.md) but not yet implemented — this file documents the
# secret *contract* ahead of that implementation, so it's self-documenting without ever holding
# real values.

# Required — lets the Edge Functions bypass RLS for their inserts into `messages` /
# `analytics_events`. NEVER exposed to the client (no VITE_ prefix, not in the app's .env.example).
SUPABASE_SERVICE_ROLE_KEY=

# Required starting Phase 9 (Contact & Resume), when the submit-message function starts actually
# sending a notification email — not required for Phase 3's insert-only scope.
RESEND_API_KEY=sb_
VITE_SUPABASE_URL=
ADMIN_NOTIFICATION_EMAIL=
